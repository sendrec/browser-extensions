{
  "manifest_version": 2,
  "name": "SendRec x 24Slides Screen Recorder",
  "description": "Record your screen and upload to SendRec x 24Slides",
  "version": "1.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "sendrec-24slides-plugin@sendrec",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "https://sendrec.24slides.dev/*",
    "https://*/*"
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background/background.js"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
